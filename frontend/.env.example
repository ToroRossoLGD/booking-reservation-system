# Leave VITE_API_URL unset during local development to use Vite's /api proxy.
# Set it when the API is hosted separately, for example:
# VITE_API_URL=https://api.example.com

# Docker Compose overrides this with http://backend:8000.
VITE_PROXY_TARGET=http://localhost:8000

# OAuth entry points exposed by the backend once provider credentials are configured.
VITE_GOOGLE_AUTH_URL=
VITE_LINKEDIN_AUTH_URL=
VITE_X_AUTH_URL=
VITE_FACEBOOK_AUTH_URL=
