APP_NAME=Booking Reservation System

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=booking_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://postgres:postgres123@postgres:5432/booking_db

JWT_SECRET=supersecretkey
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL_SECONDS=60

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@booking.local
SMTP_FROM_NAME=Booking Reservation System

RESERVATION_EXPIRE_MINUTES=15

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_EXPIRE_PENDING_INTERVAL_MINUTES=5