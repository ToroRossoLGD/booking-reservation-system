# Disposable local/staging demo only. Never point this at customer data.
APP_NAME=Bookica Demo
APP_ENV=production
DEMO_MODE=true
SMTP_MODE=disabled
POSTGRES_USER=bookica_demo
POSTGRES_DB=bookica_demo
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
DEMO_OWNER_PASSWORD=
DEMO_GUEST_PASSWORD=
# Reserved test hostname used only as configuration for local same-origin /api.
# Replace with the actual HTTPS origin for private staging.
FRONTEND_URL=https://bookica.test
FRONTEND_ORIGINS=https://bookica.test
OAUTH_COOKIE_SECURE=true
BOOKICA_HTTP_PORT=18080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE_MODE=false
PROPERTY_PHOTO_BUCKET=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
