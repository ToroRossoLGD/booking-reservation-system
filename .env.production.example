# Copy to .env.production; fill blank values, never commit real credentials.
# Supply the same file via --env-file AND BOOKICA_ENV_FILE if using another path.
APP_NAME=Bookica
# Forced by production Compose and defaulted by the API image.
APP_ENV=production
POSTGRES_USER=bookica
POSTGRES_PASSWORD=
POSTGRES_DB=bookica
# URL-encode credentials here. Host must be the Compose service postgres.
DATABASE_URL=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Replace this template with the chosen HTTPS origin (no trailing slash/path).
# Production startup rejects template domains and mismatched origins/callbacks.
FRONTEND_URL=https://bookica.your-domain.example
FRONTEND_ORIGINS=https://bookica.your-domain.example
OAUTH_COOKIE_SECURE=true
# Google login stays unconfigured until credentials and callback are supplied.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://bookica.your-domain.example/api/auth/google/callback
# External private object storage; no local MinIO is started by this profile.
PROPERTY_PHOTO_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Enable starttls (usually 587) or tls (usually 465) with a verified provider.
SMTP_MODE=disabled
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@your-domain.example
SMTP_FROM_NAME=Bookica
STRIPE_ALLOW_LIVE_MODE=false
